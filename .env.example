# Copy to .env and fill in. Used by docker-compose.yml.
JWT_SECRET=change_me_to_a_long_random_string

# URL of the frontend as seen from the user's browser
CLIENT_URL=http://localhost:3000

# Backend URL as seen from the user's BROWSER: published host port + /api.
# Baked in at build time (rebuild with: docker compose build frontend).
NEXT_PUBLIC_API_URL=http://localhost:5006/api

# Backend URL used by the Next.js API routes from INSIDE the frontend
# container: compose service name + internal port + /api.
BACKEND_URL=http://backend:5002/api

# "development" for plain http; "production" only when behind HTTPS
BACKEND_NODE_ENV=development

# Optional: needed for verification / password-reset emails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=OfferGrid

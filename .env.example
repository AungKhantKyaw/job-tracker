# Copy to .env and fill in. Used by docker-compose.yml.
JWT_SECRET=change_me_to_a_long_random_string

# URLs as seen from the user's browser
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5002

# "development" for plain http; "production" only when behind HTTPS
BACKEND_NODE_ENV=development

# Optional: needed for verification / password-reset emails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=OfferGrid
